# ShadowQA Live — copy to live/backend/.env (or put these in the repository root .env).

# Diagnosis providers: Anthropic first, OpenAI as the fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# SHADOWQA_PRIMARY_MODEL=anthropic:claude-sonnet-4-6
# SHADOWQA_FALLBACK_MODEL=openai:gpt-5.4
# Optional third provider (the planning key from `shadowqa setup` works here too).
# GEMINI_API_KEY=

# Shared secret between the browser SDK / extension / CLI and this bridge.
SHADOWQA_BRIDGE_TOKEN=change-me

# Link to the ShadowQA service so incidents become findings and the project mode is enforced.
# SHADOWQA_URL=http://127.0.0.1:8787
# SHADOWQA_TOKEN=
# SHADOWQA_PROJECT=

# Storage: local JSON files by default; set both to use MongoDB instead.
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=shadowqa_live

# Workspace description (roots Live may read/write, validation commands).
# SHADOWQA_WORKSPACE=../shadowqa.workspace.json
# Mount the Lumen Supply Co. demo store (1) or watch only your own app (0).
SHADOWQA_DEMO=1
