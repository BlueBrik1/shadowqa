{
  "manifest_version": 3,
  "name": "ShadowQA Individual",
  "version": "0.1.0",
  "description": "Track the ChatGPT and Claude conversations you choose, and turn that context into verified code with ShadowQA.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "nativeMessaging"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "ShadowQA Individual"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
