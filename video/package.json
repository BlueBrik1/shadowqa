{
  "name": "shadowqa-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion film and slide deck for ShadowQA.",
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "studio": "npm run extract && remotion studio",
    "render": "npm run extract && node scripts/render.mjs",
    "slides": "node scripts/slides.mjs",
    "still": "npm run extract && node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/google-fonts": "4.0.524",
    "@remotion/paths": "4.0.524",
    "@remotion/renderer": "4.0.524",
    "@remotion/bundler": "4.0.524",
    "@remotion/shapes": "4.0.524",
    "@remotion/transitions": "4.0.524",
    "prismjs": "1.30.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/prismjs": "1.26.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
