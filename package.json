{
  "name": "shadowqa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Context-aware QA, approved agent repairs, and Gemini planning from a desktop app — for teams (Slack + GitHub) and for individuals (ChatGPT + Claude).",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:individual && npm run desktop:build",
    "build:extension": "tsc -p vscode-extension/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p vscode-extension/tsconfig.json --noEmit && tsc -p tsconfig.individual.json --noEmit && tsc -p individual/extension/tsconfig.json --noEmit && npm run desktop:typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sandbox": "tsx scripts/sandbox-smoke.ts",
    "test:postgres": "tsx scripts/postgres-smoke.ts",
    "docs:code": "tsx scripts/code-reference.ts",
    "demo": "tsx scripts/demo.ts",
    "serve:team": "tsx scripts/serve-team.ts",
    "runner:map": "tsx scripts/runner-map.ts",
    "runner:start": "tsx scripts/runner-start.ts",
    "check": "npm run typecheck && npm test",
    "package:extension": "cd vscode-extension && node ../node_modules/@vscode/vsce/vsce package --no-dependencies --allow-missing-repository --skip-license",
    "format": "prettier --write src tests scripts vscode-extension/src individual desktop",
    "sandbox:build": "docker build -t shadowqa-sandbox:1.15.10 -f infra/sandbox.Dockerfile .",
    "build:individual": "tsc -p tsconfig.individual.json && npm run build:extension:individual",
    "build:extension:individual": "node individual/extension/build.mjs",
    "video:render": "cd video && npm run render",
    "video:studio": "cd video && npm run studio",
    "desktop:dev": "concurrently -k \"vite --config desktop/vite.config.ts\" \"tsc -p tsconfig.desktop.json --watch\" \"wait-on tcp:5183 dist-desktop/desktop/electron/main.js && cross-env SHADOWQA_DESKTOP_DEV_URL=http://localhost:5183 electron dist-desktop/desktop/electron/main.js\"",
    "desktop:build": "vite build --config desktop/vite.config.ts && tsc -p tsconfig.desktop.json",
    "desktop:typecheck": "tsc -p tsconfig.desktop.json --noEmit && tsc -p desktop/renderer/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@napi-rs/keyring": "2.0.0",
    "@opencode-ai/sdk": "1.15.10",
    "@slack/bolt": "5.1.0",
    "@slack/socket-mode": "2.0.5",
    "@slack/web-api": "7.12.0",
    "chokidar": "4.0.3",
    "dotenv": "17.2.3",
    "fastify": "5.12.4",
    "pg": "8.16.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.15.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.30",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/vscode": "1.96.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vscode/vsce": "3.7.1",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "33.3.1",
    "linkedom": "^0.18.11",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wait-on": "8.0.1"
  }
}
