# Copy to .env; never commit real secrets. Prefer an unbilled Gemini project.
DATABASE_URL=postgresql://shadowqa:shadowqa@127.0.0.1:5432/shadowqa
SHADOWQA_URL=http://127.0.0.1:4380
SHADOWQA_HOST=127.0.0.1
SHADOWQA_PORT=4380
SHADOWQA_TENANT=local
SHADOWQA_CONFIG=shadowqa.config.json
# bootstrap prints a one-time administrator token; credentials go in the OS keyring.
# SHADOWQA_TOKEN is an explicit alternative for headless services.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CALLS=100
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Optional authenticated identity linking:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SHADOWQA_PUBLIC_URL=http://127.0.0.1:4380
